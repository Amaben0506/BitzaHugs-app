{
  "expo": {
    "name": "BitzaHugs",
    "slug": "bitzahugs-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/Bitzahugs-App-Icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amandabenavidez.bitzahugs"
    },
    "android": {
      "package": "com.amandabenavidez.bitzahugs",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/Bitzahugs-App-Icon.png",
        "backgroundColor": "#FFF9F2"
      }
    },
    "web": {
      "favicon": "./assets/icons/Bitzahugs-App-Icon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/splash-background.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFF9F2"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-status-bar",
      "expo-audio",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "f664b36b-a99d-47f0-bd7f-30e05f775a16"
      }
    },
    "owner": "amandanb05"
  }
}
