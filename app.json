{
  "expo": {
    "name": "BitzaHugs",
    "slug": "bitzahugs-app",
    "version": "1.2.2",
    "orientation": "portrait",
    "icon": "./assets/icons/Bitzahugs-App-Icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bitzahugs.app",
      "buildNumber": "21",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bitzahugs.app",
      "versionCode": 34,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/Bitzahugs-App-Icon.png",
        "backgroundColor": "#FFF9F2"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "kotlinVersion": "2.1.21"
    },
    "web": {
      "favicon": "./assets/icons/Bitzahugs-App-Icon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#7B5EA7",
          "sounds": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/splash-background.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFF9F2"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.20"
          }
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-status-bar",
      "expo-audio",
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "f664b36b-a99d-47f0-bd7f-30e05f775a16"
      }
    },
    "owner": "amandanb05"
  }
}
