{
  "expo": {
    "name": "BitzaHugs",
    "slug": "bitzahugs-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/Bitzahugs-App-Icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icons/splash-background.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF9F2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amandabenavidez.bitzahugs"
    },
    "android": {
      "package": "com.amandabenavidez.bitzahugs",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/Bitzahugs-App-Icon.png",
        "backgroundColor": "#FFF9F2"
      }
    },
    "web": {
      "favicon": "./assets/icons/Bitzahugs-App-Icon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/splash-background.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFF9F2"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d9b1c8c7-5a0b-4f1e-9c3a-2f8b6e5a7c3d"
      }
    }
  }
}