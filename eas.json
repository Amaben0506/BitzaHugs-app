{
  "build": {
    "preview": {
      "android": {
        "buildType": "apk",
        "image": "latest"
      },
      "env": {
        "NODE_ENV": "production",
        "EXPO_PUBLIC_ANTHROPIC_API_KEY": "$EXPO_PUBLIC_ANTHROPIC_API_KEY"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle",
        "image": "latest"
      },
      "env": {
        "NODE_ENV": "production",
        "EXPO_PUBLIC_ANTHROPIC_API_KEY": "$EXPO_PUBLIC_ANTHROPIC_API_KEY"
      }
    }
  }
}